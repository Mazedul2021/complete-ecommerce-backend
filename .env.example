# Copy to .env and fill in your own values: cp .env.example .env
# Atlas: https://www.mongodb.com/cloud/atlas/register (free M0 cluster, no card)

# Atlas (recommended): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/olevs?retryWrites=true&w=majority
# Local mongod:        mongodb://127.0.0.1:27017/olevs
MONGODB_URI=

# Optional database name override (default: the URI path, else "olevs").
MONGODB_DB=olevs

PORT=4000
HOST=127.0.0.1
NODE_ENV=development
LOG_REQUESTS=true

# Optional: built storefront directory served by this API.
# OLEVS_DIST=../storefront/dist

# Admin account used only while no admin exists yet. Leave ADMIN_PASSWORD empty
# to have a random password generated and printed once on first boot.
ADMIN_EMAIL=admin@olevswatchshop.com
ADMIN_PASSWORD=

# Force the session cookie to be Secure (defaults to true when NODE_ENV=production).
# COOKIE_SECURE=true
